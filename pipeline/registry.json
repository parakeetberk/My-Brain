{
  "_comment": [
    "Property registry for the Parakeet ops dashboard.",
    "Rent Manager carries several parallel record types under propertyName. This file decides",
    "which ones are real communities, which roll up into a parent, and which are dropped.",
    "",
    "MAINTENANCE: when a property is sold, add it to `sold`. When RM renames a property,",
    "the old record usually gains an 'x' prefix and is dropped automatically by rule.",
    "Every name the pipeline sees is written to data/registry_audit.json with its disposition,",
    "so anything new and unclassified shows up there instead of silently landing in the numbers."
  ],
  "rules": {
    "retired_prefix": {
      "patterns": [
        "^x[A-Z]",
        "^X[A-Z]"
      ],
      "reason": "RM retired-record convention: renamed or superseded ledger"
    },
    "drop_zero_occupancy_twin": {
      "enabled": true,
      "reason": "Duplicate ledger for a community that already has a live record; 0% occupancy means the lots moved to the twin",
      "exempt_declared_segments": true
    },
    "drop_stale_months": {
      "threshold": 4,
      "reason": "No snapshot in the last N periods; disposed or renamed"
    }
  },
  "sold": [
    {
      "match": [
        "Congress Mobile Home Park",
        "Congress",
        "CONG"
      ],
      "reason": "Sold July 2026",
      "effective": "2026-07-27"
    },
    {
      "match": [
        "Shell Pointe MHC",
        "Shelle Pointe",
        "Shell Pointe",
        "SP"
      ],
      "reason": "Sold July 2026",
      "effective": "2026-07-27"
    }
  ],
